CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# std::thread uses this size, each TFTP connection runs in its own thread
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
CONFIG_FREERTOS_HZ=1000

# The partition table is written by espflash, see the runner in .cargo/config.toml
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# A window of 4 blocks has to fit in the socket queue
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
