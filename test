test_directory_list() {
    local server="$1"
    local client="$2"
    local data="hello"
    local server_pids=()

    rm -rf $TEST_DIR
    mkdir -p $TEST_DIR/{server/samples,client/samples,delete}

    echo "$data" > $TEST_DIR/server/samples/a
    echo "$data" > $TEST_DIR/server/b

    $server server 127.0.0.1:9000 $TEST_DIR/server --directory-list dir & server_pids+=($!)

    for level in data optional-data protocol optional-protocol none; do
        local received=$($client receive 127.0.0.1:9000 dir --local-path /dev/stdout --encryption-level $level | sort)
        local expected="b
samples/"
        if [ "$expected" != "$received" ]; then
            exit 1
        fi
        local received=$($client receive 127.0.0.1:9000 samples/dir --local-path /dev/stdout --encryption-level $level | sort)
        if [[ "samples/a" != "$received" ]]; then
            exit 1
        fi
    done;

    kill -9 "${server_pids[@]}"
}

