test_congestion_recovery() {
    local server="$1"
    local client="$2"
    local server_pids=()
    local pids=()

    rm -rf "$TEST_DIR"
    mkdir -p $TEST_DIR/{server,client}

    head -c 10M /dev/urandom > $TEST_DIR/client/file

    # Run 8 concurrent sends to stress the server and induce retransmits
    $server server 127.0.0.1:9100 $TEST_DIR/server --max-file-size 524288000 & server_pids+=($!)
    sleep 0.2

    for i in $(seq 1 8); do
        $client send 127.0.0.1:9100 $TEST_DIR/client/file \
            --remote-path "file-$i" --listen 127.0.0.1:0 \
            --request-timeout 30000 & pids+=($!)
    done
    wait "${pids[@]}"
    kill "${server_pids[@]}" 2>/dev/null || true

    for i in $(seq 1 8); do
        cmp -s $TEST_DIR/client/file $TEST_DIR/server/file-$i
    done
}

test_stack_only_pair() {
    local server="$1"
    local client="$2"

    test_bug_fix_server_reuse_ipv6_socket_for_receiver $server $client
    test_bug_fix_client_can_immediately_use_the_same_port_for_new_connection $server $client
    test_full_config $server $client
    test_large_files $server $client 4
    test_encryption_level $server $client
    test_encryption_authorized_only $server $client
    test_standard_tftp $server $client
}

# directory list and sync are not available in tftp-stack-only
test_stack_only() {
    local stack="./target/tftp-stack-only"

    test_stack_only_pair $stack $stack
    test_large_files $stack $stack 1
    test_congestion_recovery $stack $stack
    test_high_load $stack $stack 1
    test_high_load $stack $stack 4
    test_double_encryption $stack $stack

    for other in ./target/tftp ./target/tftp-stack-encryption; do
        test_stack_only_pair $stack $other
        test_stack_only_pair $other $stack
    done
}

test_all() {
    local encryption_targets=(./target/tftp ./target/tftp-stack-encryption)
    local non_encryption_targets=(./target/tftp-alloc ./target/tftp-stack)

    test_lib
    test_bin
    test_stack_bin

    build_release_targets

    test_sync_full_writes ./target/tftp ./target/tftp 8
    test_sync_partial_writes ./target/tftp ./target/tftp 8

    test_block_sizes

    for server in ${encryption_targets[@]}; do
        for client in ${encryption_targets[@]}; do
            test_bug_fix_server_reuse_ipv6_socket_for_receiver $server $client
            test_bug_fix_client_can_immediately_use_the_same_port_for_new_connection $server $client

            test_full_config $server $client
            test_large_files $server $client 1
            test_large_files $server $client 4
            test_congestion_recovery $server $client
            test_high_load $server $client 1
            test_high_load $server $client 4
            test_encryption_level $server $client
            test_encryption_authorized_only $server $client
            test_standard_tftp $server $client
            test_double_encryption $server $client
            test_directory_list $server $client

        done
    done

    for server in ${non_encryption_targets[@]}; do
        for client in ${non_encryption_targets[@]}; do
            test_bug_fix_server_reuse_ipv6_socket_for_receiver $server $client
            test_bug_fix_client_can_immediately_use_the_same_port_for_new_connection $server $client
            test_large_files $server $client 4
            test_high_load $server $client 4
            test_standard_tftp $server $client
        done
    done

    # non encryption server communication with encrypted clients
    for server in ${non_encryption_targets[@]}; do
        for client in ${encryption_targets[@]}; do
            test_bug_fix_server_reuse_ipv6_socket_for_receiver $server $client
            test_bug_fix_client_can_immediately_use_the_same_port_for_new_connection $server $client
            test_encryption_level $server $client "optional-data optional-protocol none"
            test_standard_tftp $server $client
        done
    done

    test_stack_only
}

# formats with nightly because rustfmt.toml uses unstable options that stable ignores
check_fmt() {
    cargo +$LINT_NIGHTLY fmt --all --check
    for manifest in std-stack-binary esp32-example esp32-idf-example; do
        cargo +$LINT_NIGHTLY fmt --manifest-path $manifest/Cargo.toml --check
    done
}

check_clippy() {
    local deny="-D warnings"
    local host="x86_64-unknown-linux-gnu"
    local features

    cargo clippy --workspace --lib --bins --tests -- $deny

    # library across the features that change its code
    for features in "" alloc encryption alloc,encryption seek multi_thread metrics \
        std std,alloc std,encryption encryption,seek,multi_thread; do
        cargo clippy -p tftp-dus --lib --tests --no-default-features --features "$features" -- $deny
    done

    for features in "" alloc encryption alloc,encryption seek multi_thread alloc,multi_thread \
        encryption,seek,multi_thread alloc,sync alloc,metrics; do
        cargo clippy -p tftp-std-binary --bins --tests --no-default-features --features "$features" -- $deny
    done

    for features in "" multi_thread,encryption std,alloc,encryption; do
        cargo clippy -p tftp-binary-common --lib --tests --no-default-features --features "$features" -- $deny
    done

    for features in "" seek multi_thread encryption encryption,seek,multi_thread; do
        cargo clippy --manifest-path std-stack-binary/Cargo.toml --all-targets --no-default-features --features "$features" -- $deny
    done

    # the examples select their toolchain and default target from their own directory
    (cd esp32-example && cargo clippy --no-default-features --target $host --all-targets -- $deny)
    (cd esp32-idf-example && cargo clippy --no-default-features --target $host --all-targets -- $deny)

    # benches use #![feature(test)]
    cargo +$LINT_NIGHTLY clippy -p tftp-dus --benches -- $deny
}

